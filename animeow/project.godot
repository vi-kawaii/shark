config_version=5

[autoload]

event="*res://event/manager.gd"

weapon="*res://weapon/manager.gd"

inventory="*res://inventory/manager.gd"

[application]

config/name="animeow"
run/main_scene="uid://blvvbifa7taac"
config/features=PackedStringArray("4.8", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[display]

window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

run/main_run_args="--max-fps 30 --rendering-driver opengl3"

[editor_plugins]

enabled=PackedStringArray()

[gui]

common/auto_focus_strategy=1
theme/custom="res://ui/default.tres"

