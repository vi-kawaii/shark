# Указывает, что это корневой файл конфигурации EditorConfig
root = true

# Настройки по умолчанию для всех файлов в проекте
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Специфичные настройки для Godot и GDScript (Критично важная часть)
[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
tab_width = 4

# Настройки для файлов разметки и документации (markdown)
[*.md]
trim_trailing_whitespace = false

# Настройки для конфигурационных и UI файлов Godot, а также JSON
[*.{tscn,tres,godot,json}]
indent_style = space
indent_size = 4

[*.{html,css}]
indent_style = space
indent_size = 2
